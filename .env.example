# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略,切勿提交真实密钥。

# ── Provider 选择 ──────────────────────────────────────────────
# zhipu（默认，快）| opencode_go（mimo，慢很多，见 README 实测表）
SNAPQUIZ_PROVIDER=zhipu

# ── 智谱 GLM（https://open.bigmodel.cn/）────────────────────────
GLM_API_KEY=your-zhipu-api-key-here

# ── opencode Go（https://opencode.ai/）──────────────────────────
# 只在 SNAPQUIZ_PROVIDER=opencode_go 时需要
OPENCODE_API_KEY=your-opencode-api-key-here

# ── 必填:题目所在的屏幕区域 left,top,width,height（屏幕「点」坐标）──
# 没有全屏默认值 —— 默认全屏会把聊天、终端、通知一并上传到云端。
SNAPQUIZ_REGION=100,100,900,700

# ── 可选 ────────────────────────────────────────────────────────
# 模型；不填则用当前 provider 的默认值（zhipu→glm-4.6v，opencode_go→mimo-v2.5）
# SNAPQUIZ_MODEL=glm-4v-flash
# SNAPQUIZ_HOTKEY=cmd+shift+space
# 超时；不填则用 provider 的默认值（zhipu 30s，opencode_go 240s）
# SNAPQUIZ_TIMEOUT=30
