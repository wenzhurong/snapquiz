# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略,切勿提交真实密钥。

# 智谱 GLM 开放平台 API Key（https://open.bigmodel.cn/）
GLM_API_KEY=your-zhipu-api-key-here

# 必填:题目所在的屏幕区域 left,top,width,height（屏幕「点」坐标）
# 没有全屏默认值 —— 默认全屏会把聊天、终端、通知一并上传到云端。
SNAPQUIZ_REGION=100,100,900,700

# 视觉模型:glm-4.6v-flash（免费档，默认）或 glm-4.6v；白名单外会被拒绝
GLM_MODEL=glm-4.6v-flash

# GLM OpenAI 兼容 endpoint（只允许官方地址，一般无需改动）
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 可选
# SNAPQUIZ_HOTKEY=cmd+shift+space
# SNAPQUIZ_TIMEOUT=30
